            /// The function's address relative to `game.exe`'s base in the loaded build: `None` before `init()`, on a build none of the IRs is, or if the loaded build's IR lacks it.
            pub fn rva() -> ::core::option::Option<u32> {
                FUNCTION.rva()
            }

            /// The function's type.
            pub type Signature = unsafe extern "system" fn() -> i32;

            static FUNCTION: ::imping_runtime::__private::Function = ::imping_runtime::__private::Function::new(
                &super::super::MODULE,
                "util::NewOnly",
                &[
                    ::core::option::Option::None,
                    ::core::option::Option::Some(::imping_runtime::__private::Site {
                        rva: RVA_STEAM_2026,
                        verification: &[],
                        shape: "",
                        pattern: ::core::option::Option::None,
                    }),
                ],
                ::core::option::Option::None,
            );

            /// Finds the function in this process.
            ///
            /// That's the function's RVA in the loaded build, unchecked, as there are no bytes to verify it by. Where the loaded build's IR lacks it, nothing finds it.
            ///
            /// # Errors
            ///
            /// Fails unless `game.exe`'s `init()` has succeeded, or where the loaded build's IR lacks it, if nothing finds it.
            pub fn resolve() -> ::imping_runtime::Result<Signature> {
                let address = FUNCTION.resolve()?;
                // SAFETY: `resolve` returns the function's non-null address, and `init`'s caller promised the function has this type.
                ::core::result::Result::Ok(unsafe {
                    ::core::mem::transmute::<usize, Signature>(address)
                })
            }

            /// The function's address in this process.
            ///
            /// # Panics
            ///
            /// If `resolve()` fails, as it does before `game.exe`'s `init()`.
            pub fn ptr() -> Signature {
                match resolve() {
                    ::core::result::Result::Ok(function) => function,
                    ::core::result::Result::Err(error) => {
                        ::core::panic!("imping: {error}")
                    }
                }
            }

            /// The original `util::NewOnly`, handed to a hook's `detour` with the arguments of the call being hooked. It can only be used during that call.
            pub struct Original<'call>(
                Signature,
                (),
                ::core::marker::PhantomData<&'call ()>,
            );

            impl Original<'_> {
                /// Calls the original function with the arguments the target passed to the hooked call.
                pub fn forward(self) -> i32 {
                    let () = self.1;
                    // SAFETY: these are the arguments the target passed to the hooked call, so this is the call it was making; `init`'s caller promised the function has type `Signature`.
                    unsafe { (self.0)() }
                }

                /// Calls the original function with other arguments.
                ///
                /// # Safety
                ///
                /// The arguments must be valid for this function.
                pub unsafe fn call(self) -> i32 {
                    // SAFETY: forwarded to the caller.
                    unsafe { (self.0)() }
                }
            }

            static SLOT: ::imping_runtime::__private::Slot<
                dyn for<'call> Fn(Original<'call>) -> i32 + Send + Sync,
                Signature,
            > = ::imping_runtime::__private::Slot::new();
            unsafe extern "system" fn thunk() -> i32 {
                let (detour, original) = SLOT.get();
                detour(Original(original, (), ::core::marker::PhantomData))
            }

            /// Hooks `util::NewOnly`: once enabled, every call runs `detour`, which receives an `Original` first, then the arguments. `original.forward()` calls the original function with the arguments the target passed; `original.call(..)` calls it with other ones.
            ///
            /// The hook is returned disabled; enable it with `Hook::enable`. Dropping the guard disables it, after which the function can be hooked again. A panic inside `detour` aborts the process.
            ///
            /// # Errors
            ///
            /// Fails unless `game.exe`'s `init()` has succeeded, if this mod already holds a hook on the function, if the loaded build's IR lacks it and nothing finds it, or if patching fails.
            pub fn hook(
                detour: impl for<'call> Fn(
                    Original<'call>,
                ) -> i32 + Send + Sync + 'static,
            ) -> ::imping_runtime::Result<::imping_runtime::Hook<Signature>> {
                // SAFETY: `thunk` has type `Signature` and calls the slot's closure; `init`'s caller promised the function has that type, and `install` fails unless `init` succeeded.
                unsafe {
                    ::imping_runtime::__private::install(
                        &FUNCTION,
                        &SLOT,
                        ::std::boxed::Box::new(detour),
                        thunk,
                    )
                }
            }
        }
    }
}
