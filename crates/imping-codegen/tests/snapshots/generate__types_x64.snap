    /// Functions and globals in the `math` namespace.
    pub mod math {
        /// `math::Normalize` at `game.exe+0x16100`. Tags: `imping-safe`.
        ///
        /// Tagged `imping-safe`, so it is safe to call: valid arguments are all it needs, and its pointer parameters are references.
